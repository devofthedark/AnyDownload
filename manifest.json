{
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-dlp-web@devofthedark.ca",
      "strict_min_version": "154.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "manifest_version": 3,
  "name": "AnyDownload",
  "description": "Download videos from anywhere you can name with the power of yt-dlp, now fully in the browser.",
  "version": "1.1.0",
  "minimum_chrome_version": "137",
  "action": {
    "default_title": "AnyDownload: click to download current page"
  },
  "permissions": [
    "scripting",
    "cookies",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'unsafe-inline' blob:;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "core/iframe/*",
        "core/sandbox/*",
        "rpc.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["rpc.js", "background.js"]
  },
  "icons": {
    "128":  "logo/icon128.png",
    "48": "logo/icon48.png",
    "32": "logo/icon32.png",
    "16": "logo/icon16.png"
  },
  "sandbox": {
    "pages": ["core/sandbox/sandbox.html"]
  }
}
